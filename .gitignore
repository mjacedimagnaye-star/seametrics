# =========================================================================
# SeaMetrics - Git Ignore Rules
# =========================================================================

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Environment Variables & Sensitive Credentials
.env
.env.*
*.key
*.pem
*.cert
credentials.json
client_secret*.json

# Operating System Files
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# IDE & Editor Configurations
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.project

# Temporary Development Artifacts & Local Backups
scratch/
backup_*/
*.tmp
*.bak
*.swp

# Large Raw Data Archives (Preserved Locally; Excluded from Git Tracking)
# SeaMetrics runtime requires processed CSVs in data/, which are fully tracked.
*.zip
*.tar.gz
*.rar
*.7z
data/2019/
*.xlsx
